{
  "name": "@stackline/resolve-uri",
  "version": "1.0.0",
  "description": "Resolve a URI relative to an optional base URI",
  "keywords": [
    "resolve",
    "uri",
    "url",
    "path",
    "stackline",
    "maintenance-fork"
  ],
  "author": "Justin Ridgewell <justin@ridgewell.name>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/stackline-resolve-uri.git"
  },
  "main": "dist/resolve-uri.umd.js",
  "module": "dist/resolve-uri.mjs",
  "types": "dist/types/resolve-uri.d.ts",
  "exports": {
    ".": [
      {
        "types": "./dist/types/resolve-uri.d.ts",
        "browser": "./dist/resolve-uri.umd.js",
        "require": "./dist/resolve-uri.umd.js",
        "import": "./dist/resolve-uri.mjs"
      },
      "./dist/resolve-uri.umd.js"
    ],
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE*",
    "license*",
    "NOTICE",
    "UPSTREAM.md",
    "CHANGELOG.md",
    "README.md",
    "readme.md"
  ],
  "engines": {
    "node": ">=6.0.0"
  },
  "scripts": {
    "build": "rollup -c --bundleConfigAsCjs && tsc --project tsconfig.build.json",
    "test": "mocha && node test/stackline.cjs",
    "test:package": "node scripts/test-package.mjs"
  },
  "devDependencies": {
    "mocha": "12.0.2",
    "rollup": "4.63.5",
    "@rollup/plugin-typescript": "12.3.0",
    "typescript": "5.9.3",
    "tslib": "2.8.1"
  },
  "bugs": {
    "url": "https://github.com/alexandroit/stackline-resolve-uri/issues"
  },
  "homepage": "https://github.com/alexandroit/stackline-resolve-uri#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
